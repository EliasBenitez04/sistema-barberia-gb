PORT=3000
NODE_ENV=development
APP_TIMEZONE=America/Asuncion
PUBLIC_BASE_URL=

# PostgreSQL 9.5+
DATABASE_URL=postgres://postgres:postgres@localhost:5432/barberia_gb
DB_SSL=false

# Seguridad
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# Se crea solo si no existe ningún administrador
ADMIN_EMAIL=admin@barberiagb.local
ADMIN_PASSWORD=CambiaEstaClave123!
ADMIN_NAME=Administrador

# WhatsApp Cloud API (Meta)
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Webhook de Meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=cambia-este-token-de-verificacion
WHATSAPP_APP_SECRET=

# Prueba inicial (Meta suele incluir hello_world en cuentas de prueba)
WHATSAPP_TEST_TEMPLATE_NAME=hello_world
WHATSAPP_TEST_TEMPLATE_LANG=en_US

# Recordatorio de turno: 5 variables
# {{1}} cliente, {{2}} fecha, {{3}} hora, {{4}} barbero, {{5}} servicio
WHATSAPP_TEMPLATE_NAME=appointment_reminder
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_REMINDER_HOURS=24

# Confirmación obligatoria del turno por WhatsApp.
# El template debe tener 5 variables de cuerpo y 2 botones Quick Reply:
# botón 0 = Confirmar turno, botón 1 = Cancelar turno.
WHATSAPP_CONFIRMATION_REQUIRED=true
WHATSAPP_CONFIRMATION_TIMEOUT_MINUTES=10
WHATSAPP_CONFIRMATION_TEMPLATE_NAME=appointment_confirmation
WHATSAPP_CONFIRMATION_TEMPLATE_LANG=es
